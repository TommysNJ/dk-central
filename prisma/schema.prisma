generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Enumeraciones
enum rol {
  admin_sistema
  admin_centro
  usuario_operativo
}

enum area {
  mantenimiento
  seguridad
  limpieza
  administracion
}

/// Tabla: centros_comerciales
model centros_comerciales {
  id_centro_comercial  Int       @id @default(autoincrement()) @map("id_centro_comercial")
  nombre               String    @unique @map("nombre")
  ciudad               String    @map("ciudad")
  ubicacion            String?   @map("ubicacion")
  id_grupo_telegram    String    @unique @map("id_grupo_telegram")
  usuarios             usuarios[]
  mensajes_limpios     mensajes_limpios[]

  @@map("centros_comerciales")
}

/// Tabla: usuarios
model usuarios {
  id_usuario          Int      @id @default(autoincrement()) @map("id_usuario")
  nombre              String   @map("nombre")
  correo              String   @unique @map("correo")
  telefono            String?  @unique @map("telefono")
  usuario             String   @unique @map("usuario")
  password            String   @map("password")
  rol                 rol      @map("rol")
  area                area?    @map("area")
  id_centro_comercial Int?     @map("id_centro_comercial")
  centro_comercial    centros_comerciales? @relation(fields: [id_centro_comercial], references: [id_centro_comercial])

  @@index([rol, id_centro_comercial], map: "idx_usuarios_rol_centro")
  @@index([usuario], map: "idx_usuarios_usuario")
  @@map("usuarios")
}

/// Tabla: mensajes_limpios
model mensajes_limpios {
  id_mensaje             Int                   @id @default(autoincrement()) @map("id_mensaje")
  id_centro_comercial    Int                   @map("id_centro_comercial")
  centro_comercial       centros_comerciales   @relation(fields: [id_centro_comercial], references: [id_centro_comercial])
  contenido_original     String                @map("contenido_original")
  contenido_limpio       String                @map("contenido_limpio")
  remitente              String?               @map("remitente")
  fecha_envio            DateTime              @map("fecha_envio")
  procesado              Boolean               @default(false) @map("procesado")

  @@map("mensajes_limpios")
}