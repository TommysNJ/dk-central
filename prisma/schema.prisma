generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// =============================
/// ENUMERACIONES
/// =============================
enum rol {
  admin_sistema
  admin_centro
  usuario_operativo
}

enum area {
  recepcion
  administracion
  mantenimiento
  seguridad
  mercadeo
  sso
  otros
}

enum estado_incidente {
  nuevo
  en_proceso
  completado
}

/// =============================
/// TABLA: centros_comerciales
/// =============================
model centros_comerciales {
  id_centro_comercial  Int                 @id @default(autoincrement()) @map("id_centro_comercial")
  nombre               String              @unique @map("nombre")
  ciudad               String              @map("ciudad")
  ubicacion            String?             @map("ubicacion")
  id_grupo_telegram    String              @unique @map("id_grupo_telegram")

  usuarios             usuarios[]
  mensajes_limpios     mensajes_limpios[]
  resumenes_diarios    resumenes_diarios[]

  @@map("centros_comerciales")
}

/// =============================
/// TABLA: usuarios
/// =============================
model usuarios {
  id_usuario          Int                   @id @default(autoincrement()) @map("id_usuario")
  nombre              String                @map("nombre")
  correo              String                @unique @map("correo")
  telefono            String?               @unique @map("telefono")
  usuario             String                @unique @map("usuario")
  password            String                @map("password")
  rol                 rol                   @map("rol")
  area                area?                 @map("area")
  id_centro_comercial Int?                  @map("id_centro_comercial")

  two_factor_enabled  Boolean               @default(false)
  two_factor_secret   String?               

  reset_password_token     String?
  reset_password_expires   DateTime?

  must_change_password Boolean              @default(true)

  centro_comercial    centros_comerciales?  @relation(fields: [id_centro_comercial], references: [id_centro_comercial])

  historial_incidentes historial_incidentes[]

  resumenes_diarios    resumenes_diarios[]


  @@index([rol, id_centro_comercial], map: "idx_usuarios_rol_centro")
  @@index([usuario], map: "idx_usuarios_usuario")
  @@map("usuarios")
}

/// =============================
/// TABLA: mensajes_limpios
/// =============================
model mensajes_limpios {
  id_mensaje             Int                 @id @default(autoincrement()) @map("id_mensaje")
  id_mensaje_telegram    Int                 @map("id_mensaje_telegram")
  id_centro_comercial    Int                 @map("id_centro_comercial")
  centro_comercial       centros_comerciales @relation(fields: [id_centro_comercial], references: [id_centro_comercial])

  contenido_original     String              @db.Text @map("contenido_original")
  contenido_limpio       String              @db.Text @map("contenido_limpio")
  remitente              String?             @map("remitente")
  fecha_envio            DateTime            @map("fecha_envio")

  fecha_envio_date       DateTime?           @db.Date @map("fecha_envio_date")
  fecha_envio_time       String?             @map("fecha_envio_time")

  procesado              Boolean             @default(false) @map("procesado")

  clasificacion          mensajes_clasificados?

  @@unique([id_centro_comercial, id_mensaje_telegram], map: "unique_msg_per_centro")
  @@map("mensajes_limpios")
}

/// =============================
/// TABLA: incidentes
/// =============================
model incidentes {
  id_incidente      Int                      @id @default(autoincrement()) @map("id_incidente")
  nombre            String                   @unique @map("nombre")
  area              area                     @map("area")

  keywords          keywords_incidentes[]
  clasificados      mensajes_clasificados[]

  @@map("incidentes")
}

/// =============================
/// TABLA: keywords_incidentes
/// =============================
model keywords_incidentes {
  id_keyword       Int        @id @default(autoincrement()) @map("id_keyword")
  palabra          String     @unique @map("palabra")
  id_incidente     Int        @map("id_incidente")

  incidente incidentes @relation(fields: [id_incidente], references: [id_incidente])

  @@map("keywords_incidentes")
}

/// =============================
/// TABLA: mensajes_clasificados
/// =============================
model mensajes_clasificados {
  id_mensaje_clasificado Int              @id @default(autoincrement()) @map("id_mensaje_clasificado")
  id_mensaje_limpio      Int              @unique @map("id_mensaje_limpio")
  id_incidente           Int              @map("id_incidente")

  confianza              Float            @map("confianza")

  estado                 estado_incidente @default(nuevo) @map("estado")
  observaciones          String?          @db.Text @map("observaciones")

  mensaje_limpio mensajes_limpios @relation(fields: [id_mensaje_limpio], references: [id_mensaje])
  incidente      incidentes       @relation(fields: [id_incidente], references: [id_incidente])

  historial_incidentes historial_incidentes[]
  
  @@map("mensajes_clasificados")
}

/// =============================
/// TABLA: historial_incidentes
/// =============================
model historial_incidentes {
  id_historial           Int                    @id @default(autoincrement()) @map("id_historial")
  id_mensaje_clasificado Int                    @map("id_mensaje_clasificado")
  id_usuario             Int                    @map("id_usuario")
  estado                 estado_incidente       @map("estado")
  observaciones          String?                @db.Text @map("observaciones")
  fecha                  DateTime               @default(now()) @map("fecha")
  fecha_cambio           DateTime?              @db.Date @map("fecha_cambio")
  hora_cambio            String?                @map("hora_cambio")

  usuario                usuarios               @relation(fields: [id_usuario], references: [id_usuario])
  mensaje_clasificado    mensajes_clasificados  @relation(fields: [id_mensaje_clasificado], references: [id_mensaje_clasificado])

  @@map("historial_incidentes")
}


/// =============================
/// TABLA: resumenes_diarios
/// =============================
model resumenes_diarios {
  id_resumen           Int                  @id @default(autoincrement()) @map("id_resumen")
  fecha                DateTime             @db.Date @map("fecha")
  id_centro_comercial  Int                  @map("id_centro_comercial")
  area                 area                 @map("area")
  resumen              String               @db.Text @map("resumen")
  id_usuario           Int?                 @map("id_usuario")
  fecha_actualizacion  DateTime             @default(now()) @updatedAt @map("fecha_actualizacion")

  usuario              usuarios?            @relation(fields: [id_usuario], references: [id_usuario])
  centro_comercial     centros_comerciales  @relation(fields: [id_centro_comercial], references: [id_centro_comercial])


  @@unique([fecha, id_centro_comercial, area], map: "unique_resumen_por_dia_centro_area")
  @@index([id_centro_comercial, area, fecha], map: "idx_resumenes_centro_area_fecha")
  @@map("resumenes_diarios")
}